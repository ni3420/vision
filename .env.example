# Database
DB_URL=mongodb://127.0.0.1:27017/vision

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public app URL used for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# AI providers
# AI_MODE: auto (default) -> live when a real key exists, mock outside production
#          live -> always call the provider, fail loudly when unconfigured
#          mock -> never call a provider (local demo only)
# Images never mock implicitly: without an image provider key they return 503.
AI_MODE=auto

# Image: Cloudflare Workers AI (FLUX.2 klein 4B, multipart)
# Preferred: your own Worker from /worker. CLOUDFARE_API_KEY is the Worker's shared
# secret and must match `wrangler secret put IMAGE_API_TOKEN`.
CLOUDFARE_URL=
CLOUDFARE_API_KEY=
# Alternative when CLOUDFARE_URL is empty: call the Cloudflare API directly.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Chat: Groq (preferred) or Gemini (fallback)
# Defaults: openai/gpt-oss-120b and gemini-3.6-flash. The old
# llama-3.3-70b-versatile / gemini-2.5-flash IDs are retired. Override below if your
# project has access to a different current model.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Music: Treblo
TREBLO_API_KEY=

# Asset storage
# STORAGE_DRIVER: s3 (recommended) | imagekit | local (dev only)
# With no explicit value the driver is inferred: ImageKit credentials > S3 credentials > local.
# Production assets should live in a bucket; local files vanish on redeploy.
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=

# S3 / R2 / Backblaze B2 (required when STORAGE_DRIVER=s3)
# Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#               S3_REGION=<region>   e.g. us-west-004
#               A bare host (s3.<region>.backblazeb2.com) is accepted; https:// is added.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                S3_REGION=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ImageKit (required when STORAGE_DRIVER=imagekit)
# URL endpoint looks like https://ik.imagekit.io/<your_imagekit_id>
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Set true to upload private files and serve them with signed URLs.
IMAGEKIT_PRIVATE_FILES=false
